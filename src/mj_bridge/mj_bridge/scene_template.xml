<mujoco model="panda_scene">

  <include file="panda.xml"/>

  <option timestep="0.002"
          integrator="implicitfast"
          solver="Newton"
          iterations="100"
          tolerance="1e-10"
          noslip_iterations="20"
          noslip_tolerance="1e-8"
          impratio="10"/>

  <asset>
    <mesh name="lego_2x2" file="LEGO_Duplo_brick_2x2.stl" scale="0.001 0.001 0.001"/>
    <mesh name="lego_2x4" file="LEGO_Duplo_brick_2x4.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <visual>
    <global offwidth="960" offheight="720"/>
    <headlight ambient="0.25 0.25 0.25" diffuse="0.45 0.45 0.45" specular="0.12 0.12 0.12"/>
  </visual>

  <worldbody>

    <camera name="realsense" pos="0.49 -0.15 1.2" fovy="45"/>
    <light name="workspace_key"
           pos="0.15 -0.45 1.50"
           dir="0.15 0.30 -1"
           diffuse="0.60 0.58 0.54"
           specular="0.18 0.18 0.16"/>
    <light name="workspace_fill"
           pos="0.65 0.55 1.15"
           dir="-0.20 -0.45 -1"
           diffuse="0.32 0.34 0.38"
           specular="0.08 0.08 0.10"/>

    <geom name="floor" type="plane" size="0 0 0.05"/>

    <body name="table" pos="0.40 0 0.02">
        <geom
            name="table_geom"
            type="box"
            size="0.30 0.50 0.02"
            contype="1"
            conaffinity="1"
            friction="3 0.1 0.01"
            solref="0.002 1"
            solimp="0.999 0.9999 0.0001"
            density="10000"
            />
    </body>
    <body name="assembly_base_plate" pos="0.25 0.0 0.043">
        <geom
          name="assembly_base_plate_geom"
          type="box"
          size="0.192 0.192 0.003"
          rgba="0.15 0.15 0.15 1"
          friction="5.0 0.2 0.02"
          solref="0.002 1"
          solimp="0.995 0.9999 0.0001"/>
      </body>

  </worldbody>

</mujoco>
